generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id              String   @id
  name            String
  dept            String
  allowedAnnual   Float
  remainingAnnual Float
  allowedCasual   Float
  remainingCasual Float
  allowedShort    Float    @default(2)
  remainingShort  Float    @default(2)
  attendanceDate  String
  presentToday    Boolean  @default(false)
  presentTime     String?
}